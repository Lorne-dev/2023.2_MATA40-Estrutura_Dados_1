class No:
    def __init__(self, valor):
        self.valor = valor
        self.prox = None

    def imprimir(self):
        return(f"Valor: {self.valor}")

class Lista:
    def __init__(self):
        self.head = None

    def inserir(self, novo_no):
        if self.head == None:
            self.head = novo_no
        else:
            novo_no.prox = self.head
            self.head = novo_no

    def imprimir(self):
        if self.head == None:
            print("Lista vazia")
        else:
            atual = self.head
            while atual != None:
                print(atual.imprimir())
                atual = atual.prox

def main():
    lista = Lista()
    lista.imprimir()
    lista.inserir(No(10))
    lista.inserir(No(100))
    lista.inserir(No(1000))
    lista.imprimir()

if __name__ == "__main__":
    main()
            








